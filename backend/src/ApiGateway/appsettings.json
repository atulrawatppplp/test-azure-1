{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "authService",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "products": {
        "ClusterId": "productService",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "products-root": {
        "ClusterId": "productService",
        "Match": { "Path": "/api/products" }
      },
      "orders": {
        "ClusterId": "orderService",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "orders-root": {
        "ClusterId": "orderService",
        "Match": { "Path": "/api/orders" }
      },
      "notifications": {
        "ClusterId": "notificationService",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "notifications-root": {
        "ClusterId": "notificationService",
        "Match": { "Path": "/api/notifications" }
      }
    },
    "Clusters": {
      "authService": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5169/" }
        }
      },
      "productService": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5166/" }
        }
      },
      "orderService": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5167/" }
        }
      },
      "notificationService": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5168/" }
        }
      }
    }
  }
}
